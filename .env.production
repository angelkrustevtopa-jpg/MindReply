# MindReply Production Environment Variables
# Set these in Vercel Dashboard under Project Settings > Environment Variables

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://www.mind-reply.com

# AI Provider (OpenAI)
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxx
MRAGENT_MODEL=gpt-5

# Blob Storage (Vercel Blob)
# Get your token from https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxx

# Gmail Integration (Optional - for email intake)
MINDREPLY_IMAP_HOST=imap.gmail.com
MINDREPLY_IMAP_USER=your-email@gmail.com
MINDREPLY_IMAP_PASSWORD=your-app-specific-password

# Calendar Integration (Optional)
MINDREPLY_CALENDAR_OUTBOX=calendar-outbox.jsonl

# Vercel Analytics (Auto-configured)
# No manual configuration needed

# Cloudflare (Optional - if using Cloudflare Workers)
# CF_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxx
# CF_API_TOKEN=xxxxxxxxxxxxxxxxxxxxx
